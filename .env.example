DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_NOTIFICATION_WS_URL=ws://localhost:3001/notifications
NOTIFICATION_WS_SERVER_URL=http://localhost:3001
NOTIFICATION_WS_SECRET=change-me

# Supabase Storage via S3-compatible API
SUPABASE_S3_BUCKET=
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
MEDIA_MIGRATION_DIRS=public/media,public/uploads,uploads,media
MEDIA_MIGRATION_OVERWRITE=false

# Stripe Connect
STRIPE_SECRET_KEY=
STRIPE_CONNECT_SECRET_KEY=
STRIPE_CHECKOUT_CURRENCY=usd
STRIPE_IDR_TO_USD_RATE=17958

# PayPal Connect
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_BUYER_COUNTRY=ID

# Resend Email
RESEND_API_KEY=
RESEND_DEFAULT_FROM_EMAIL=onboarding@resend.dev
RESEND_DEFAULT_FROM_NAME=Eventbro
